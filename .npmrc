# 套件的 npm 设置。
#
# legacy-peer-deps：各插件的 peerDependencies 指向 @deepseek-ai/*（DSH 宿主自带的包），
# 这些包不发布在公共 npm 上，也不能由本仓库安装——运行时由宿主的 node_modules 提供。
# 关掉自动安装 peer 才能让 `npm ci` 在没有 DSH 源码树的干净机器上跑通。
legacy-peer-deps=true

# 打日志即可，不要在安装期访问审计接口（离线/内网环境常见失败点）。
fund=false
audit=false

# 不使用 lockfile 里的链接方式以外的额外行为。
save-exact=false
