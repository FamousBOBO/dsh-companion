{
  "name": "@local/dsh-companion-memory-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "三月七的陪伴空间：宿主侧栏面板（陪伴首页、生活与日程、记忆与档案、连接与工具、工作区、设置与诊断），Host 半挂载带鉴权的记忆 API。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "server.mjs",
    "lib",
    "client.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
