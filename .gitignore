# ---- 运行时数据（永不入库）----
# data/ 是套件的运行期数据根；home/ 与 workspace/ 出现在仓库根时只可能是
# 某个插件以仓库根为 cwd 跑出来的残留，同样不入库。
data/
home/
workspace/
group-workspace/
desktop-data/
logs/
backups/
tmp/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 本地配置与密钥 ----
config/suite.json
config/persona.md
config/profile/companion.patch.yml
config/profile/*.local.yml
.env
.env.*
!.env.example
*.pem
*.key
.credentials.yaml

# ---- 依赖与构建产物 ----
# 只有真正的构建输出被忽略。多数模块的 lib/ 是手写源码，不能忽略。
# 例外：dsh-super-injector 是第三方包，它的构建需要一份 DSH 源码检出（DSH_CHECKOUT），
# 用户机器上不可能有，所以随仓库分发预构建产物（见该目录 PROVENANCE.md）。
node_modules/
pnpm-lock.yaml
plugins/**/build/**
plugins/**/dist/**
plugins/dsh-super-injector/lib/**/*.map
plugins/*/node_modules/
.plugin-manager/

# ---- 媒体与模型产物（测试用的合成图例外，它们是测试资产）----
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp3
*.wav
*.ogg
*.flac
*.mp4
!plugins/**/icon.svg
!plugins/**/assets/icon.svg
!plugins/**/test/fixtures/**
!docs/**/*.png
models/

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.bak
*.orig
__pycache__/
*.pyc
.venv/
