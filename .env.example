# 密钥与账号凭据模板。
#
# 复制为 .env.local 后填写。.env.* 已被 gitignore，永远不会进入仓库。
# 套件只从环境变量读取密钥；任何 API、日志、错误信息都不会回传明文。
#
# 用到哪个填哪个，不需要的留空即可。

# ── 模型提供方 ────────────────────────────────────────────────
# 具体变量名取决于你在 DSH profile 里配置的 provider（见 docs/02-configuration.md）。
OPENCODE_GO_API_KEY=
DEEPSEEK_API_KEY=

# ── 生图 / TTS（companion-media）──────────────────────────────
# 配置里只填「环境变量名」，密钥值放这里。
OPENAI_COMPAT_API_KEY=
NAI_API_KEY=
FISH_AUDIO_API_KEY=
GPT_SOVITS_API_KEY=
INDEX_TTS_API_KEY=
BREEZE_TTS_API_KEY=
DRAMA3_API_KEY=

# ── QQ 通道（dsh-channel-qq）──────────────────────────────────
# NapCat / OneBot v11 的正向 WebSocket access token。
# 注意：这里只是给 setup 参考；实际值请写进 config/suite.json 的 services.onebot.accessToken
# 或本文件后由启动脚本注入环境，不要写进任何会被提交的文件。
ONEBOT_ACCESS_TOKEN=

# ── 健康 sidecar（companion-health / sidecars）─────────────────
HUAWEI_HEALTH_SIDECAR_URL=
